{
  "name": "@nurama/sdk",
  "version": "1.4.0",
  "description": "Provides API, web-socket, and additional utilities for interfacing with the Nurama platform.",
  "main": "dist/NuramaClient.js",
  "module": "dist/NuramaClient.js",
  "browser": "dist/browser/nurama-sdk.js",
  "types": "dist/NuramaClient.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/NuramaClient.d.ts",
      "import": "./dist/NuramaClient.js",
      "require": "./dist/NuramaClient.js"
    },
    "./bot": {
      "types": "./dist/BotClient.d.ts",
      "import": "./dist/BotClient.js",
      "require": "./dist/BotClient.js"
    },
    "./browser": "./dist/browser/nurama-sdk.js",
    "./browser-min": "./dist/browser/nurama-sdk.min.js",
    "./bot-browser": "./dist/browser/nurama-bot-sdk.js",
    "./bot-browser-min": "./dist/browser/nurama-bot-sdk.min.js"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "node scripts/dev.cjs",
    "gen:version": "node scripts/generate-version-info.cjs",
    "prebuild": "pnpm gen:version",
    "build:tsc": "tsc",
    "build:browser": "esbuild src/browser-entry.js --bundle --outfile=dist/browser/nurama-sdk.js --format=iife --platform=browser",
    "build:browser-min": "esbuild src/browser-entry.js --bundle --minify --outfile=dist/browser/nurama-sdk.min.js --format=iife --platform=browser",
    "build:bot": "pnpm gen:version && esbuild src/bot-browser-entry.js --bundle --outfile=dist/browser/nurama-bot-sdk.js --format=iife --platform=browser",
    "build:bot-min": "pnpm gen:version && esbuild src/bot-browser-entry.js --bundle --minify --outfile=dist/browser/nurama-bot-sdk.min.js --format=iife --platform=browser",
    "copy:examples": "shx mkdir -p examples/example-html && shx cp dist/browser/nurama-sdk.min.js examples/example-html/",
    "build": "pnpm build:tsc && pnpm build:browser && pnpm build:browser-min && pnpm build:bot && pnpm build:bot-min && pnpm copy:examples",
    "lint": "eslint .",
    "lint:main": "eslint --ignore-pattern 'example-react/**' --ext .js,.jsx,.ts,.tsx .",
    "docs:typedoc": "pnpm gen:version && typedoc"
  },
  "keywords": [
    "api",
    "sdk",
    "nurama"
  ],
  "author": "Nurama Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@nurama/types": "^1.4.0",
    "jwt-decode": "^4.0.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jwt-decode": "^2.2.1",
    "@types/node": "^22.14.1",
    "@types/socket.io-client": "^1.4.36",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.3.4",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nurama-team/nurama.git",
    "directory": "packages/sdk"
  }
}
